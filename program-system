-- VIEW
CREATE VIEW Delivery_Report AS
SELECT
S.Shipment_ID,
C.Customer_Name,
D.Driver_Name,
V.Vehicle_Number,
DL.Delivery_Date,
DL.Delivery_Status
FROM DELIVERY DL
JOIN SHIPMENT S ON DL.Shipment_ID=S.Shipment_ID
JOIN CUSTOMER C ON S.Customer_ID=C.Customer_ID
JOIN DRIVER D ON DL.Driver_ID=D.Driver_ID
JOIN VEHICLE V ON DL.Vehicle_ID=V.Vehicle_ID;


-- CURSOR PROCEDURE
DELIMITER $$

CREATE PROCEDURE Shipment_Report()
BEGIN
    DECLARE done INT DEFAULT FALSE;
    DECLARE sid INT;
    DECLARE status1 VARCHAR(30);

    DECLARE cur CURSOR FOR
        SELECT Shipment_ID, Shipment_Status FROM SHIPMENT;

    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done=TRUE;

    OPEN cur;

    read_loop: LOOP

        FETCH cur INTO sid,status1;

        IF done THEN
            LEAVE read_loop;
        END IF;

        SELECT CONCAT('Shipment ID : ',sid,' Status : ',status1) AS Report;

    END LOOP;

    CLOSE cur;

END$$
SELECT * FROM Delivery_Report;
DELIMITER ;
